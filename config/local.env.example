# Machine-specific paths. Copy to config/local.env (git-ignored) and edit, or export the same
# variables in the shell (the environment wins). KEY=VALUE, one per line; no spaces around '='.
# config/sources.yaml and the scripts read them as ${NAME}.

# Root of the TCGA source tree: data/raw/{clinical,molecular}, data/reference, data/intermediate
CTSM_TCGA_ROOT=/path/to/tcga_source_root
# GENCODE v45 comprehensive annotation (gencode.v45.annotation.gtf.gz)
CTSM_GENCODE_GTF=/path/to/gencode.v45.annotation.gtf.gz
# TCGA Clinical Data Resource, Liu et al. 2018, Table S1 (TCGA-CDR-SupplementalTableS1.xlsx)
CTSM_TCGA_CDR=/path/to/TCGA-CDR-SupplementalTableS1.xlsx
# GRCh38 primary assembly (GENCODE GRCh38.primary_assembly.genome.fa.gz); MSI steps 42 onward
CTSM_GENOME_FASTA=/path/to/GRCh38.primary_assembly.genome.fa.gz
# rMATS junction-count store of the 2026-10-14 re-extraction (data_extract_10_14_2026: samples.tsv,
# events/, sparse/<view>/ CSR with ijc, sjc, inc_len, skip_len, psi); MSI step 62 (D-77)
CTSM_SPLICE_COUNTS=/path/to/data_extract_10_14_2026
# (Step 62's external reference files - UCSC RepeatMasker, BPHunter Dataset S1, the UCSC
# hg19->hg38 chain - need no setting: they sit under data.nosync/ctsm_v1/external/, listed with
# their checksums in config/sources.yaml, external_d77.)
# Python with splice-assay 0.4.0 installed (step 17 only)
CTSM_SA_PYTHON=/path/to/env/bin/python
# Interpreter for scripts/run_pipeline.sh (default: python on PATH)
PYTHON=/path/to/env/bin/python
